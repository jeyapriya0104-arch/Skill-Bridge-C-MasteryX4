
#include <iostream>
#include <string>
#include <unordered_map>
using namespace std;

int main() {
    string s;
    cout << "Enter a string: ";
    cin >> s;

    unordered_map<char, int> freq;

    // Count character frequencies
    for (char c : s) {
        freq[c]++;
    }

    // Find the first non-repeating character
    char result = '\0';

    for (char c : s) {
        if (freq[c] == 1) {
            result = c;
            break;
        }
    }

    if (result != '\0') {
        cout << "First non-repeating character: "
             << result;
    } else {
        cout << -1;
    }

    return 0;
}
